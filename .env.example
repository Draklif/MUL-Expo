# Copia este archivo como .env y llénalo. El .env no se sube a git, que es
# justamente el punto: config.js sí, y todo lo de aquí es secreto.

# ---------------------------------------------------------------------
#  Obligatorio: sin esto la app no arranca
# ---------------------------------------------------------------------

# Contraseña compartida de los docentes. Entran con su correo institucional
# (el de la lista DOCENTES en config.js) más esta clave.
PASSWORD_DOCENTES=

# Firma las cookies de sesión. Si se deja vacía, la app se inventa una nueva en
# cada arranque y los docentes que estaban dentro tienen que volver a entrar.
# Genera una así:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Puerto del servidor. Vacío = 3000.
PORT=

# ---------------------------------------------------------------------
#  Opcional: los correos automáticos
# ---------------------------------------------------------------------

# Cuenta de Gmail desde la que salen los avisos.
SMTP_USER=tucuenta@gmail.com

# NO es la contraseña de tu Gmail: es una "contraseña de aplicación" de 16
# letras que se genera en https://myaccount.google.com/apppasswords (hay que
# tener la verificación en dos pasos activa en la cuenta). Se puede pegar con
# espacios o sin ellos.
SMTP_PASS=abcd efgh ijkl mnop

# URL pública por la que entran los estudiantes: es la que llevan los enlaces
# de los correos, y con ngrok cambia cada vez que se levanta el túnel.
# Si se deja vacía, cada enlace sale de la dirección por la que llegó esa
# visita: bien para el estudiante que se registra desde el túnel, mal para el
# docente que aprueba desde localhost (mandaría enlaces a localhost).
SITIO_URL=https://xxxxx.ngrok-free.app
