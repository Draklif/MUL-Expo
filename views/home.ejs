<% const title = 'Materias — Expo Eval'; const active = 'home'; %>
<%- include('partials/header', { title, active, docente, CRITERIOS, ESCALA_MAX }) %>

<main class="app-shell">
  <h1>Expo <em>Multimedia</em></h1>

  <% if (query.nuevas !== undefined) {
       const n = Number(query.nuevas) || 0, om = Number(query.omitidas) || 0; %>
    <div class="alert <%= n ? 'ok' : 'err' %>" style="margin-top:16px">
      <% if (n) { %>✓ <%= n %> materia<%= n === 1 ? '' : 's' %> creada<%= n === 1 ? '' : 's' %><% } else { %>No se creó ninguna materia<% } %><% if (om) { %> · <%= om %> ya existía<%= om === 1 ? '' : 'n' %><% } %>.
    </div>
  <% } %>

  <%/* ───── SEMESTRE ───── */%>
  <% if (query.periodo_nuevo) { %>
    <div class="alert ok" style="margin-top:16px">✓ Semestre <%= query.periodo_nuevo %> abierto.</div>
  <% } else if (query.periodo_activo) { %>
    <div class="alert ok" style="margin-top:16px">
      ✓ <%= query.periodo_activo %> es ahora el semestre activo: los registros nuevos entran ahí.
    </div>
  <% } else if (query.periodo_error) { %>
    <div class="alert err" style="margin-top:16px">
      <%= query.periodo_error === 'existe' ? 'Ese semestre ya existe.' : 'El código va en formato AAAA-NN, por ejemplo 2027-10.' %>
    </div>
  <% } %>

  <div class="section-head" style="margin-top:18px">
    <h2>Semestre</h2>
    <span class="count"><%= periodo.codigo %></span>
  </div>

  <div class="filtros">
    <% periodos.forEach(p => { %>
      <a href="/panel?periodo=<%= p.id %>" class="filtro <%= p.id === periodo.id ? 'activo' : '' %>"
         title="<%= p.activo ? 'Semestre activo: aquí entran los registros nuevos' : 'Semestre cerrado' %>">
        <%= p.codigo %><% if (p.activo) { %><span class="punto-activo"></span><% } %>
      </a>
    <% }) %>
  </div>

  <% if (!periodo.activo) { %>
    <div class="aviso-periodo">
      <div>
        Estás viendo <strong><%= periodo.codigo %></strong>, que ya no es el semestre
        activo. Lo que registren los estudiantes hoy entra en
        <strong><%= periodoActivo.codigo %></strong>.
      </div>
      <form method="POST" action="/periodos/<%= periodo.id %>/activar"
            onsubmit="return confirm('¿Hacer de <%= periodo.codigo %> el semestre activo? Los registros nuevos empezarán a entrar ahí.');">
        <button type="submit" class="btn ghost">Activar <%= periodo.codigo %></button>
      </form>
    </div>
  <% } else { %>
    <p class="hint" style="margin-top:-4px">
      Es el semestre activo <span class="punto-activo"></span>: aquí caen los
      registros que hagan los estudiantes. Las materias son las mismas en todos
      los semestres.
    </p>
  <% } %>

  <details class="panel" style="margin-top:12px">
    <summary>Abrir un semestre nuevo</summary>
    <div class="panel-body">
      <form method="POST" action="/periodos">
        <div class="form-row">
          <label for="codigo">Código del semestre</label>
          <input type="text" id="codigo" name="codigo" placeholder="2027-10" required
                 pattern="\d{4}-\d{2}" title="Formato AAAA-NN, por ejemplo 2027-10"
                 maxlength="7" autocomplete="off" />
          <p class="hint">
            Las materias siguen siendo las mismas; lo que empieza de cero son los
            estudiantes, sus proyectos y sus notas.
          </p>
        </div>
        <label class="pick-linea">
          <input type="checkbox" name="activar" value="1" checked />
          <span>Activarlo de una vez (los registros nuevos entrarán ahí)</span>
        </label>
        <button type="submit" class="btn block ghost" style="margin-top:14px">+ Abrir semestre</button>
      </form>
    </div>
  </details>

  <p class="eyebrow" style="margin-top:26px">Crear materia</p>

  <form method="POST" action="/materias" class="card" style="margin-top:0">
    <div class="form-row">
      <input type="text" name="nombre" placeholder="Nombre de la materia (ej. Diseño Web III)" required maxlength="80" autocomplete="off" />
    </div>
    <button type="submit" class="btn block">+ Crear materia</button>
  </form>

  <details class="panel">
    <summary>Crear varias materias de una vez</summary>
    <div class="panel-body">
      <form method="POST" action="/materias/batch">
        <div class="form-row">
          <label for="nombres">Pega la lista — una materia por línea</label>
          <textarea id="nombres" name="nombres" rows="5" placeholder="Diseño Web III&#10;Animación 2D&#10;Producción Audiovisual"></textarea>
          <p class="hint">Se omiten las materias que ya existen.</p>
        </div>
        <button type="submit" class="btn block ghost">+ Crear todas</button>
      </form>
    </div>
  </details>

  <div class="section-head">
    <h2>Materias</h2>
    <span class="count"><%= materias.length %> <%= soloMias ? 'mías' : 'total' %></span>
  </div>

  <div class="filtros" style="margin-bottom:14px">
    <a href="/panel?mias=0" class="filtro <%= soloMias ? '' : 'activo' %>">
      Todas (<%= totales.todas %>)
    </a>
    <a href="/panel?mias=1" class="filtro <%= soloMias ? 'activo' : '' %>">
      Solo las mías (<%= totales.mias %>)
    </a>
  </div>

  <p class="hint" style="margin:-6px 0 12px">
    Los conteos son de <strong><%= periodo.codigo %></strong>.
  </p>

  <% if (materias.length === 0) { %>
    <div class="empty">
      <% if (soloMias && totales.todas) { %>
        No has creado ninguna materia. <a href="/panel?mias=0">Ver todas</a>.
      <% } else { %>
        Aún no hay materias. Crea la primera arriba.
      <% } %>
    </div>
  <% } else { %>
    <% materias.forEach(m => { %>
      <a href="/materias/<%= m.id %>" class="list-item">
        <div class="row">
          <div>
            <div class="title"><%= m.nombre %></div>
            <div class="submeta">
              <%= m.created_by === docenteId ? 'Tuya' : 'Creada por ' + m.creador %>
            </div>
          </div>
          <div class="pills">
            <% if (m.n_pendientes) { %>
              <div class="pill alerta"><%= m.n_pendientes %> por revisar</div>
            <% } %>
            <div class="pill"><%= m.n_proyectos %> proyecto<%= m.n_proyectos === 1 ? '' : 's' %></div>
          </div>
        </div>
      </a>
    <% }) %>
  <% } %>
</main>

<%- include('partials/footer') %>
