<%- include('../partials/head', { title: title, css: css, themeColor: themeColor }) %>
<%- include('partials/panel-top') %>

<main class="ink">
  <% if (aviso.borrada) { %>
    <div class="aviso bueno" style="margin-top:26px"><p style="margin:0">Se borró la edición.</p></div>
  <% } %>
  <% if (aviso.error === "periodo_formato") { %>
    <div class="aviso malo" style="margin-top:26px">
      <p style="margin:0">El código del semestre va como <code>2026-20</code>: el año, un guion y 10 o 20.</p>
    </div>
  <% } %>

  <section class="ink-sec">
    <div class="sec-top">
      <div>
        <p class="eyebrow">Organización</p>
        <h2>Ediciones</h2>
      </div>
    </div>

    <% if (!ediciones.length) { %>
      <div class="vacio">
        Todavía no hay ninguna edición. Abre la primera aquí abajo y las
        inscripciones quedan listas.
      </div>
    <% } else { %>
      <div style="overflow-x:auto">
        <table class="tabla">
          <thead>
            <tr>
              <th>Edición</th>
              <th>Semestre</th>
              <th>Estado</th>
              <th>Dibujando</th>
              <th>Por revisar</th>
              <th>Dibujos</th>
              <th>Palabras</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% ediciones.forEach(function (e) { %>
              <tr>
                <td>
                  <a href="/ink/panel/ediciones/<%= e.id %>" style="text-decoration:none">
                    <span class="nom"><%= e.nombre %></span>
                  </a>
                  <div class="mini">
                    <% if (e.fase.momento_inicio) { %>
                      Arranca <%= e.fase.momento_inicio.diaCorto %>
                      <% if (e.fase.clave === "en_curso") { %> · día <%= e.fase.dia %> de <%= e.fase.dias %><% } %>
                    <% } else { %>
                      Sin fecha
                    <% } %>
                  </div>
                </td>
                <td class="mini">
                  <%= e.periodo || "—" %>
                  <% if (e.periodo_activo) { %><br /><span class="chip ok">Activo</span><% } %>
                </td>
                <td>
                  <span class="chip <%= e.estado === 'finalizada' ? 'no' : e.estado === 'en_curso' ? 'rojo' : 'ok' %>">
                    <%= e.estado === "inscripcion" ? "Inscripciones" : e.estado === "en_curso" ? "En curso" : "Cerrada" %>
                  </span>
                  <% if (e.fase.clave === "en_curso") { %><span class="chip vivo">Corriendo</span><% } %>
                  <% if (e.galeria_publica) { %><span class="chip azul">Galería</span><% } %>
                  <% if (e.resultados_publicos) { %><span class="chip rojo">Podio</span><% } %>
                </td>
                <td><%= e.cifras.inscritos %></td>
                <td>
                  <% if (e.cifras.pendientes > 0) { %>
                    <span class="chip pend"><%= e.cifras.pendientes %></span>
                  <% } else { %><span class="mini">—</span><% } %>
                </td>
                <td><%= e.cifras.dibujos || "—" %></td>
                <td class="mini"><%= e.cifras.palabras %> / <%= e.dias %></td>
                <td><a href="/ink/panel/ediciones/<%= e.id %>" class="btn chico">Abrir</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>

  <%/* ───── PASAR DE SEMESTRE ─────
       Este es el botón que hace que el reto se pueda repetir sin tocar nada:
       cierra la edición que esté abierta y crea una nueva y vacía en el
       semestre que se elija. Lo del semestre pasado no se borra, se archiva
       con sus dibujos y su podio. */%>
  <section class="ink-sec">
    <div class="herramienta">
      <h3>Abrir la edición de un semestre</h3>
      <p class="sec-lead">
        Deja cerrada la edición que esté abierta y arranca una nueva, sin
        inscritos y con las inscripciones abiertas. La anterior se queda como
        está: sus palabras, sus dibujos y su podio siguen viéndose.
      </p>

      <form method="POST" action="/ink/panel/ediciones">
        <div class="fila">
          <div class="campo">
            <label for="periodo_id">Semestre</label>
            <select name="periodo_id" id="periodo_id">
              <% periodos.forEach(function (p) { %>
                <option value="<%= p.id %>" <%= p.activo ? "selected" : "" %>>
                  <%= p.codigo %><%= p.activo ? " (activo)" : "" %>
                </option>
              <% }); %>
            </select>
            <p class="ayuda">O escribe uno nuevo al lado y se crea solo.</p>
          </div>
          <div class="campo">
            <label for="periodo_nuevo">Semestre nuevo</label>
            <input type="text" name="periodo_nuevo" id="periodo_nuevo" maxlength="7"
                   placeholder="2027-10" pattern="\d{4}-\d{2}" />
            <p class="ayuda">Año, guion y 10 (primer semestre) o 20 (segundo).</p>
          </div>
        </div>

        <div class="campo">
          <label for="nombre">Nombre de la edición (opcional)</label>
          <input type="text" name="nombre" id="nombre" maxlength="80"
                 placeholder="INKreible · 2027-10" />
        </div>

        <div class="fila">
          <div class="campo">
            <label for="dias">Cuántos días</label>
            <input type="number" name="dias" id="dias" min="1" max="365" value="<%= porDefecto.dias %>" />
          </div>
          <div class="campo">
            <label for="semanas">En cuántas semanas</label>
            <input type="number" name="semanas" id="semanas" min="1" max="52" value="<%= porDefecto.semanas %>" />
            <p class="ayuda">De aquí sale cuántos ganadores semanales hay.</p>
          </div>
          <div class="campo">
            <label for="cupo">Cupo</label>
            <input type="number" name="cupo" id="cupo" min="1" max="1000" placeholder="sin tope" />
          </div>
        </div>

        <div class="fila">
          <div class="campo">
            <label for="drive_url">Carpeta de Drive (se puede poner después)</label>
            <input type="url" name="drive_url" id="drive_url" maxlength="500"
                   placeholder="https://drive.google.com/drive/folders/…" />
          </div>
          <div class="campo">
            <label for="nomenclatura">Nomenclatura de los archivos</label>
            <input type="text" name="nomenclatura" id="nomenclatura" maxlength="80"
                   value="<%= porDefecto.nomenclatura %>" />
            <p class="ayuda">Las llaves las reemplaza el sitio: <code>{CODIGO}</code>, <code>{DIA}</code>, <code>{TECNICA}</code>.</p>
          </div>
        </div>

        <label class="opcion" style="max-width:540px">
          <input type="checkbox" name="activar_periodo" value="1" checked />
          <span class="t">Dejarlo como el semestre activo</span>
          <span class="d">
            Es el semestre del programa entero: la Expo, el torneo y la jam
            también empiezan a guardar ahí. Es lo normal al empezar un semestre
            nuevo.
          </span>
        </label>

        <div style="margin-top:24px">
          <button type="submit" class="btn">Abrir la edición</button>
        </div>
      </form>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
