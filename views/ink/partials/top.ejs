<%/* ─────────────────────────────────────────────────────────────────
     Cabecera del sitio de INKreible.

     El menú es UNO SOLO para las dos pantallas, igual que en el torneo y en
     la jam: los mismos enlaces en el mismo orden. En escritorio se pintan a
     la derecha de la marca y en celular bajan a una barra fija abajo, al
     alcance del pulgar. Lo único que cambia es el CSS, así que no hay dos
     menús que mantener sincronizados.

     Los íconos van dibujados con trazos redondeados y sin relleno —lápiz,
     no bloque—: son de un cuaderno, como todo lo demás de esta página. Solo
     se ven en la barra de abajo; arriba el CSS los esconde.
     ───────────────────────────────────────────────────────────────── */%>
<%
  const ICONOS = {
    inicio:      '<path d="M3 9l7-6 7 6v8a1 1 0 0 1-1 1h-4v-5H8v5H4a1 1 0 0 1-1-1z"/>',
    palabras:    '<path d="M4 3h12v14H4z"/><path d="M7 7h6M7 10h6M7 13h3"/>',
    galeria:     '<path d="M3 4h14v12H3z"/><path d="M3 13l4-4 3 3 3-4 4 5"/>',
    resultados:  '<path d="M6 3h8v5a4 4 0 0 1-8 0z"/><path d="M10 12v4M7 17h6"/>',
    inscripcion: '<path d="M13 3l4 4-9 9-4 1 1-4z"/>',
  };
  const icono = (k) =>
    `<svg class="ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"
          stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONOS[k]}</svg>`;
%>

<header class="ink-top">
  <div class="ink-top-in publica">
    <a href="/inkreible" class="ink-marca"><em>INK</em>reible</a>

    <nav class="ink-nav tabs" aria-label="Secciones del reto">
      <a href="/inkreible" class="<%= activa === 'inicio' ? 'on' : '' %>"
         <%- activa === 'inicio' ? 'aria-current="page"' : '' %>>
        <%- icono('inicio') %><span>Inicio</span>
      </a>
      <a href="/ink/palabras" class="<%= activa === 'palabras' ? 'on' : '' %>"
         <%- activa === 'palabras' ? 'aria-current="page"' : '' %>>
        <%- icono('palabras') %><span>Palabras</span>
      </a>
      <a href="/ink/galeria" class="<%= activa === 'galeria' ? 'on' : '' %>"
         <%- activa === 'galeria' ? 'aria-current="page"' : '' %>>
        <%- icono('galeria') %><span>Galería</span>
      </a>
      <a href="/ink/resultados" class="<%= activa === 'resultados' ? 'on' : '' %>"
         <%- activa === 'resultados' ? 'aria-current="page"' : '' %>>
        <%- icono('resultados') %><span>Podio</span>
      </a>
      <a href="/ink/inscripcion" class="<%= activa === 'inscripcion' ? 'on' : '' %>"
         <%- activa === 'inscripcion' ? 'aria-current="page"' : '' %>>
        <%- icono('inscripcion') %><span>Inscripción</span>
      </a>
    </nav>
  </div>
</header>
