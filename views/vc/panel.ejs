<%- include('../partials/head', { title: title, css: css, themeColor: themeColor }) %>
<%- include('partials/panel-top') %>

<main class="vc">
  <% if (aviso.borrado) { %>
    <div class="aviso bueno" style="margin-top:26px"><p style="margin:0">Se borró el torneo.</p></div>
  <% } %>

  <%/* ───── EL SEMESTRE EN CURSO ─────
       Los torneos no se crean desde aquí: hay uno por juego y por semestre y
       se abren solos al arrancar. Lo que sí hace falta decir es si están
       recibiendo equipos, porque eso se prende en config y no en esta
       pantalla —y sin decirlo, alguien va a buscar el interruptor un rato—. */%>
  <section class="vc-sec">
    <div class="sec-top">
      <div>
        <p class="eyebrow">Semestre <%= periodoVC ? periodoVC.codigo : "—" %></p>
        <h2>Torneos</h2>
      </div>
      <span class="chip <%= abierta ? 'ok' : 'no' %>">
        Inscripciones <%= abierta ? "abiertas" : "cerradas" %>
      </span>
    </div>

    <p class="sec-lead">
      Uno por juego, abierto solo al arrancar. Para empezar el semestre
      siguiente se cambia <code>PERIODO</code> en <code>config.js</code>: estos
      quedan archivados y salen otros vacíos en su lugar.
      <% if (!abierta) { %>
        Las inscripciones se abren poniendo <code>inscripciones: true</code> en
        Virtual Champions, en ese mismo archivo.
      <% } %>
    </p>

    <% if (!torneos.length) { %>
      <div class="vacio" style="margin-top:20px">
        No hay ningún torneo en este semestre. Revisa que
        <code>config.VC.juegos</code> tenga al menos un juego y reinicia.
      </div>
    <% } else { %>
      <%- include('partials/tabla-torneos', { lista: torneos, historial: false }) %>
    <% } %>
  </section>

  <%/* ───── SEMESTRES PASADOS ─────
       Quedan de consulta y con menos columnas: de un torneo terminado ya no
       importa cuántos faltan por revisar. */%>
  <% if (pasados.length) { %>
    <section class="vc-sec">
      <div class="sec-top">
        <div>
          <p class="eyebrow">Archivo</p>
          <h2 style="font-size:22px">Semestres pasados</h2>
        </div>
      </div>
      <%- include('partials/tabla-torneos', { lista: pasados, historial: true }) %>
    </section>
  <% } %>
</main>

<%- include('../partials/footer') %>
