<%- include('../partials/head', { title: title, descripcion: 'Bracket del torneo de ' + (juego ? juego.nombre : 'Virtual Champions'), css: css, themeColor: themeColor }) %>
<%- include('partials/top') %>

<main class="vc">
  <section class="vc-sec">
    <p class="eyebrow"><%= juego ? juego.nombre : "Virtual Champions" %></p>
    <h2>Bracket</h2>
    <p class="sec-lead">
      Eliminación directa. Gana y avanzas; pierde y se acabó.
      <% if (torneo) { %>Cada llave lleva su formato al lado.<% } %>
    </p>
  </section>

  <% if (!torneo) { %>
    <div class="vacio" style="margin-top:26px">
      Todavía no hay torneo abierto de <%= juego ? juego.nombre : "este juego" %>.
      <div style="margin-top:14px"><a href="/vc/inscripcion" class="btn chico">Inscribirme</a></div>
    </div>
  <% } else if (!bracket.length) { %>
    <div class="vacio" style="margin-top:26px">
      El bracket se arma cuando cierren las inscripciones.
      <div style="margin-top:14px"><a href="/vc/<%= juego.id %>/equipos" class="btn ghost chico">Ver los equipos inscritos</a></div>
    </div>
  <% } else { %>
    <div style="margin-top:8px">
      <%- include('partials/bracket') %>
    </div>
  <% } %>
</main>

<%- include('partials/pie') %>
<%- include('../partials/footer') %>
