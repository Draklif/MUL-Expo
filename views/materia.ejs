<% const title = materia.nombre + ' — Expo Eval'; const active = 'home'; %>
<%- include('partials/header', { title, active, docente, CRITERIOS, ESCALA_MAX }) %>

<main class="app-shell">
  <a href="/panel" class="back-link">Materias</a>
  <h1><%= materia.nombre %></h1>
  <p class="periodo-actual <%= periodo.activo ? '' : 'pasado' %>">
    <%= periodo.codigo %><%= periodo.activo ? '' : ' · semestre cerrado' %>
  </p>

  <% if (query.revisado === 'aprobada') { %>
    <div class="alert ok" style="margin-top:16px">✓ Registro aprobado: el proyecto ya está en la lista y sus integrantes quedaron registrados.</div>
  <% } else if (query.revisado === 'rechazada') { %>
    <div class="alert err" style="margin-top:16px">Registro rechazado. El estudiante puede ver el motivo con su código.</div>
  <% } %>

  <%/* ───── REGISTROS DE EXPOSITORES ───── */%>
  <div class="section-head" style="margin-top:22px">
    <h2>Registros de expositores</h2>
    <span class="count"><%= pendientes.length %> por revisar</span>
  </div>

  <% if (pendientes.length === 0) { %>
    <div class="empty">
      <% if (revisadas.length) { %>Todo revisado por ahora.<% } else { %>Aún no llegan registros de estudiantes.<% } %>
    </div>
  <% } else { %>
    <% pendientes.forEach(s => { %>
      <article class="solicitud">
        <div class="sol-head">
          <div>
            <h3><%= s.titulo %></h3>
            <p class="sol-meta">
              <%= s.sala_nombre || 'Sala sin definir' %> ·
              <%= s.integrantes.length %> integrante<%= s.integrantes.length === 1 ? '' : 's' %> ·
              código <strong><%= s.codigo %></strong>
            </p>
          </div>
          <span class="estado pend">Pendiente</span>
        </div>

        <% if (s.descripcion) { %>
          <p class="sol-desc"><%= s.descripcion %></p>
        <% } %>

        <ul class="sol-equipo">
          <% s.integrantes.forEach(i => { %>
            <li>
              <span><%= i.nombre %></span>
              <% if (i.email) { %><em><%= i.email %></em><% } %>
            </li>
          <% }) %>
        </ul>

        <p class="sol-contacto">Registró <%= s.contacto_nombre %> · <%= s.contacto_email %></p>

        <div class="sol-acciones">
          <form method="POST" action="/materias/<%= materia.id %>/solicitudes/<%= s.id %>/aprobar">
            <button type="submit" class="btn">Aprobar y crear proyecto</button>
          </form>

          <details class="sub">
            <summary>Rechazar</summary>
            <form method="POST" action="/materias/<%= materia.id %>/solicitudes/<%= s.id %>/rechazar" style="margin-top:10px">
              <div class="form-row" style="margin-bottom:10px">
                <textarea name="nota" rows="2" maxlength="300"
                          placeholder="Motivo (lo verá el estudiante al consultar su código)"></textarea>
              </div>
              <button type="submit" class="btn danger">Rechazar registro</button>
            </form>
          </details>
        </div>
      </article>
    <% }) %>
  <% } %>

  <% if (revisadas.length) { %>
    <details class="panel" style="margin-top:12px">
      <summary>Ya revisados (<%= revisadas.length %>)</summary>
      <div class="panel-body">
        <% revisadas.forEach(s => { %>
          <div class="sol-revisada">
            <div class="sol-head">
              <div>
                <strong><%= s.titulo %></strong>
                <p class="sol-meta">
                  <%= s.sala_nombre || 'Sin sala' %> · <%= s.contacto_nombre %>
                  <% if (s.revisor) { %> · revisó <%= s.revisor %><% } %>
                </p>
              </div>
              <span class="estado <%= s.estado === 'aprobada' ? 'ok' : 'no' %>">
                <%= s.estado === 'aprobada' ? 'Aprobada' : 'Rechazada' %>
              </span>
            </div>
            <% if (s.nota_docente) { %><p class="sol-desc"><%= s.nota_docente %></p><% } %>
          </div>
        <% }) %>
      </div>
    </details>
  <% } %>

  <%/* ───── ESTUDIANTES REGISTRADOS ───── */%>
  <div class="section-head" style="margin-top:26px">
    <h2>Estudiantes registrados</h2>
    <span class="count"><%= estudiantes.length %> confirmado<%= estudiantes.length === 1 ? '' : 's' %></span>
  </div>

  <% if (estudiantes.length === 0) { %>
    <div class="empty">
      Nadie con registro aprobado todavía. Los estudiantes se registran en
      <strong>/registro</strong> y aparecen aquí cuando apruebas su proyecto.
    </div>
  <% } else { %>
    <ul class="registrados">
      <% estudiantes.forEach(e => { %>
        <li>
          <div class="reg-quien">
            <span class="reg-nombre"><%= e.nombre %></span>
            <span class="reg-correo"><%= e.email %></span>
          </div>
          <span class="reg-proyecto">
            <%= e.proyectos.length ? e.proyectos.join(' · ') : 'sin proyecto' %>
          </span>
        </li>
      <% }) %>
    </ul>
  <% } %>

  <p class="hint" style="margin-top:10px">
    Esta es la lista completa de quienes pueden ser calificados. Quien no
    aparezca aquí no se registró o su registro no está aprobado, y por lo tanto
    su nota queda en 0.0.
  </p>

  <div class="section-head" style="margin-top:30px">
    <h2>Proyectos</h2>
    <span class="count"><%= proyectos.length %> total</span>
  </div>

  <% if (proyectos.length === 0) { %>
    <div class="empty">Aún no hay proyectos en esta materia.</div>
  <% } else { %>
    <% proyectos.forEach(p => { %>
      <a href="/proyectos/<%= p.id %>" class="list-item">
        <div class="row">
          <div>
            <div class="title"><%= p.titulo %></div>
            <% if (p.integrantes && p.integrantes.trim()) { %>
              <div class="submeta" style="font-style:italic; color:var(--ink-dim)"><%= p.integrantes.split('\n').filter(s => s.trim()).length %> integrantes</div>
            <% } else { %>
              <div class="submeta" style="font-style:italic; color:var(--ink-dim)">Individual</div>
            <% } %>
          </div>
          <div class="pill"><%= p.n_jueces %> <%= p.n_jueces === 1 ? 'juez' : 'jueces' %></div>
        </div>
      </a>
    <% }) %>
  <% } %>

  <%/* ───── CERTIFICADOS ───── */%>
  <div class="section-head" id="certificados" style="margin-top:30px">
    <h2>Certificados</h2>
    <span class="count"><%= certificados.length %> emitido<%= certificados.length === 1 ? '' : 's' %></span>
  </div>

  <% if (query.emitidos !== undefined) {
       const nuevos = Number(query.emitidos) || 0, act = Number(query.actualizados) || 0; %>
    <div class="alert ok">
      ✓ <%= nuevos %> certificado<%= nuevos === 1 ? '' : 's' %> nuevo<%= nuevos === 1 ? '' : 's' %><% if (act) { %> · <%= act %> actualizado<%= act === 1 ? '' : 's' %><% } %>.
    </div>
  <% } %>

  <% if (podio.length) { %>
    <ol class="podio">
      <% podio.forEach(p => { %>
        <li class="podio-<%= p.puesto %>">
          <span class="podio-puesto"><%= p.puesto %>.°</span>
          <span class="podio-titulo"><%= p.titulo %></span>
          <span class="podio-nota"><%= p.promedio.toFixed(2) %></span>
        </li>
      <% }) %>
    </ol>
  <% } else { %>
    <div class="empty">
      Todavía no hay proyectos calificados, así que no hay podio. Se pueden
      emitir igual: todos saldrían con constancia de participación.
    </div>
  <% } %>

  <form method="POST" action="/materias/<%= materia.id %>/certificados" style="margin-top:12px"
        onsubmit="return confirm('Se generan los certificados con las notas de este momento. Si ya existían, se actualizan sin cambiar sus enlaces.');">
    <button type="submit" class="btn block ghost">
      <%= certificados.length ? 'Regenerar certificados' : 'Generar certificados' %>
    </button>
  </form>
  <p class="hint" style="margin-top:8px">
    Uno por estudiante: puesto para los tres primeros y constancia de
    participación para el resto. Los datos quedan congelados al emitirlos.
  </p>

  <% if (certificados.length) { %>
    <details class="panel" style="margin-top:12px">
      <summary>Ver los <%= certificados.length %> certificados y sus enlaces</summary>
      <div class="panel-body">
        <ul class="lista-cert">
          <% certificados.forEach(c => { %>
            <li>
              <span class="cert-medalla <%= c.etiqueta.cls %>"><%= c.puesto || '·' %></span>
              <span class="cert-quien">
                <strong><%= c.estudiante %></strong>
                <em><%= c.etiqueta.label %> · <%= c.proyecto_titulo %></em>
              </span>
              <a href="/certificado/<%= c.codigo %>" target="_blank" rel="noopener" class="cert-link">
                <%= c.codigo %> ↗
              </a>
            </li>
          <% }) %>
        </ul>
      </div>
    </details>
  <% } %>

  <div style="margin-top:30px; text-align:right">
    <form method="POST" action="/materias/<%= materia.id %>/delete" onsubmit="return confirm('¿Eliminar esta materia y todos sus proyectos? Esta acción no se puede deshacer.');" style="display:inline">
      <button type="submit" class="btn danger">Eliminar materia</button>
    </form>
  </div>
</main>

<%- include('partials/footer') %>
