<%/* ─────────────────────────────────────────────────────────────────
     LA LISTA DE UNA SALIDA

     Esta pantalla se usa de pie, con el celular en una mano y la plata en la
     otra, mientras hay cola. Por eso los que faltan van primero y por eso las
     dos casillas de pago son lo más grande de cada ficha: es lo único que se
     viene a tocar aquí.

     Cerrada, la ficha dice nombre, los dos códigos y los dos pagos, y nada
     más. Todo lo otro —el documento, el teléfono, el correo, la nota, los
     botones— aparece al pulsarla, que es cuando alguien dejó de cobrar y se
     puso a resolver un caso. Lo completo está en el CSV.
     ───────────────────────────────────────────────────────────────── */%>
<%- include('../partials/head', { title: title, css: css, themeColor: themeColor }) %>
<%- include('partials/panel-top') %>

<main class="sal">
  <%/* ───── AVISOS ───── */%>
  <%
    const MALOS = {
      pagado: "Ese registro ya tiene un pago marcado: no se borra. Si la persona se retiró, desmárcale los pagos y queda la constancia de que los tuvo.",
      sin_pagos: "Ese registro todavía no tiene los dos pagos: no hay confirmación que reenviar.",
    };
    const malo = MALOS[aviso.error];
  %>

  <% if (aviso.ok) { %>
    <div class="aviso bueno" style="margin-top:24px"><p style="margin:0">Guardado.</p></div>
  <% } %>
  <% if (aviso.confirmado === "1") { %>
    <div class="aviso bueno" style="margin-top:24px">
      <p style="margin:0">Quedó confirmado y le salió el correo con las normas.</p>
    </div>
  <% } %>
  <% if (aviso.confirmado === "0") { %>
    <div class="aviso malo" style="margin-top:24px">
      <p style="margin:0">
        Los pagos quedaron guardados, pero el correo de confirmación no salió.
        <% if (!correoActivo) { %>
          Los correos están apagados en el <code>.env</code>.
        <% } else { %>
          Puedes reintentarlo con «Reenviar confirmación».
        <% } %>
      </p>
    </div>
  <% } %>
  <% if (aviso.reenviado === "1") { %>
    <div class="aviso bueno" style="margin-top:24px"><p style="margin:0">Confirmación reenviada.</p></div>
  <% } %>
  <% if (aviso.reenviado === "0") { %>
    <div class="aviso malo" style="margin-top:24px"><p style="margin:0">No se pudo enviar el correo.</p></div>
  <% } %>
  <% if (malo) { %>
    <div class="aviso malo" style="margin-top:24px"><p style="margin:0"><%= malo %></p></div>
  <% } %>

  <%/* ───── CABECERA ───── */%>
  <section class="sal-sec">
    <div class="sec-top">
      <div>
        <p class="eyebrow"><%= salida.lugar %></p>
        <h2><%= salida.nombre %></h2>
        <div class="chips">
          <span class="chip <%= abierta ? 'ok' : 'no' %>">
            <%= abierta ? "Registros abiertos" : cerrada === "lleno" ? "Cupo lleno" : cerrada === "pasada" ? "Ya pasó" : "Registros cerrados" %>
          </span>
          <% if (salida.sale) { %>
            <span class="chip">Sale el <%= salida.sale.dia %>, <%= salida.sale.hora %></span>
          <% } %>
        </div>
      </div>
      <div class="acciones">
        <a href="/salidas/panel/<%= salida.id %>/lista.csv" class="btn ghost chico">Descargar la lista (CSV)</a>
        <a href="/salidas/<%= salida.id %>" class="btn ghost chico">Ver la página pública</a>
      </div>
    </div>

    <%/* Dos renglones y en ese orden: arriba las tres cuentas de gente, que
         es lo que se mira de reojo mientras hay cola; abajo las dos de plata,
         que es lo que se cuadra al final del día sentado. Los cupos libres se
         quitaron: son una resta de dos números que ya están ahí arriba. */%>
    <div class="tarjeta">
      <div class="datos cifras">
        <div class="dato">
          <div class="k">Registrados</div>
          <div class="v grande"><%= cifras.total %><% if (cifras.cupo) { %><span class="mini"> / <%= cifras.cupo %></span><% } %></div>
        </div>
        <div class="dato">
          <div class="k">Confirmados</div>
          <div class="v grande" style="color:var(--monte)"><%= cifras.confirmados %></div>
        </div>
        <div class="dato faltan">
          <div class="k">Faltan por pagar</div>
          <div class="v grande" style="color:<%= cifras.faltan ? 'var(--ambar)' : 'var(--tinta-mute)' %>"><%= cifras.faltan %></div>
        </div>
        <div class="dato recaudo">
          <div class="k">Recaudo transporte</div>
          <div class="v plata"><%= pesos(cifras.recaudo_transporte) || "—" %></div>
          <div class="mini"><%= cifras.transporte %> <%= cifras.transporte === 1 ? "pago" : "pagos" %></div>
        </div>
        <div class="dato recaudo">
          <div class="k">Recaudo póliza</div>
          <div class="v plata"><%= pesos(cifras.recaudo_poliza) || "—" %></div>
          <div class="mini"><%= cifras.poliza %> <%= cifras.poliza === 1 ? "pago" : "pagos" %></div>
        </div>
      </div>
    </div>
  </section>

  <%/* ───── LAS FICHAS ─────
       Un solo bloque de marcado para las dos listas: cambia el título y la
       gente, no la ficha. Duplicarla sería garantizar que dentro de un mes las
       dos tengan campos distintos. */%>
  <%
    const bloques = [
      {
        id: "faltan",
        eyebrow: "Por cobrar",
        titulo: pendientes.length === 1 ? "Falta 1 persona" : `Faltan ${pendientes.length} personas`,
        lead: "Marcar un pago es afirmar que recibiste el dinero y que viste el consentimiento firmado: las dos cosas pasan en el mismo escritorio. Cuando queden las dos casillas, al estudiante le sale el correo que lo confirma.",
        lista: pendientes,
        vacio: "Nadie pendiente. Todos los registrados ya pagaron.",
      },
      {
        id: "confirmados",
        eyebrow: "Con todo pago",
        titulo: `Confirmados (${confirmados.length})`,
        lead: "Estos ya recibieron su correo. Son los que suben al bus, y a los que se les pasa lista el día de la salida.",
        lista: confirmados,
        vacio: "Todavía nadie ha pagado las dos cosas.",
        // El recuento de la asistencia va SOLO en este bloque: es el único
        // donde hay a quién pasarle lista.
        asistencia: true,
      },
    ];
  %>

  <% bloques.forEach(function (b) { %>
    <section class="sal-sec" id="<%= b.id %>">
      <div class="sec-top">
        <div>
          <p class="eyebrow"><%= b.eyebrow %></p>
          <h2 style="font-size:24px"><%= b.titulo %></h2>
        </div>

        <%/* Cómo va la lista, de un vistazo. "Sin pasar" es lo que dice si la
             lista ya se pasó entera o va por la mitad, y por eso se muestra
             aunque sea cero: su ausencia es la señal de que ya está. */%>
        <% if (b.asistencia && b.lista.length) { %>
          <div class="recuento">
            <span class="chip <%= cifras.asistieron ? 'ok' : '' %>">
              <%= cifras.asistieron %> <%= cifras.asistieron === 1 ? "asistió" : "asistieron" %>
            </span>
            <% if (cifras.faltaron) { %>
              <span class="chip malo">
                <%= cifras.faltaron %> no <%= cifras.faltaron === 1 ? "vino" : "vinieron" %>
              </span>
            <% } %>
            <% if (cifras.sin_pasar) { %>
              <span class="chip"><%= cifras.sin_pasar %> sin pasar</span>
            <% } %>
          </div>
        <% } %>
      </div>
      <p class="sec-lead" style="margin:0 0 18px"><%= b.lead %></p>

      <% if (!b.lista.length) { %>
        <div class="vacio"><%= b.vacio %></div>
      <% } else { %>
        <div class="regs">
          <% b.lista.forEach(function (r) { %>
            <article class="reg" id="r<%= r.id %>">
              <%/* El renglón que se ve siempre. El nombre manda pero se recorta
                   en una línea: un nombre de cuatro apellidos no puede empujar
                   las casillas de pago a otro renglón. Completo aparece al
                   abrir la ficha. */%>
              <div class="reg-cab">
                <div class="reg-quien">
                  <div class="nom" title="<%= r.nombre %>"><%= r.nombre %></div>
                  <%/* Solo los dos códigos, y rotulados por separado. Son dos
                       números distintos que se dictan por teléfono, y pegados
                       con un punto en medio se leen como uno solo mal copiado.
                       El documento y el contacto no caben aquí sin recortarse
                       a medias, así que viven abajo, en la ficha abierta. */%>
                  <div class="reg-meta">
                    <span class="m"><b>Código</b> <span class="cod"><%= r.codigo %></span></span>
                    <span class="m"><b>Estudiantil</b> <%= r.codigo_estudiante %></span>
                  </div>
                </div>

                <%/* El estado y las casillas van juntos en una sola pieza: en
                     pantalla angosta bajan a su propio renglón sin arrastrar
                     consigo al chevron, que se queda arriba con el nombre. */%>
                <div class="reg-marcas">
                  <span class="chip <%= r.estado.cls %>"><%= r.estado.label %></span>

                  <%/* El formulario manda el estado completo de las dos
                       casillas, no un "sumar uno": así se ve lo mismo que se
                       guarda y un clic equivocado se deshace desmarcando. */%>
                  <form method="POST" action="/salidas/panel/registros/<%= r.id %>/pagos" class="pagos">
                    <label class="pago">
                      <input type="checkbox" name="pago_transporte" value="1" <%= r.pago_transporte ? "checked" : "" %> />
                      Transporte
                    </label>
                    <label class="pago">
                      <input type="checkbox" name="pago_poliza" value="1" <%= r.pago_poliza ? "checked" : "" %> />
                      Póliza
                    </label>
                    <button type="submit" class="btn chico">Guardar</button>
                  </form>

                  <%/* Pasar lista, solo a quien va en el bus. Un toque marca y
                       el mismo toque otra vez desmarca: esto se usa de pie en
                       la puerta del bus, mirando caras y no la pantalla, y el
                       dedo se equivoca. Sin vuelta atrás, corregir obligaría a
                       abrir la ficha con doce personas esperando para subir. */%>
                  <% if (r.confirmado) { %>
                    <form method="POST" action="/salidas/panel/registros/<%= r.id %>/asistencia" class="lista">
                      <button type="submit" name="asistio" value="1"
                              class="pasa <%= r.asistio === 1 ? 'vino' : '' %>"
                              aria-pressed="<%= r.asistio === 1 ? 'true' : 'false' %>">Asistió</button>
                      <button type="submit" name="asistio" value="0"
                              class="pasa <%= r.asistio === 0 ? 'falto' : '' %>"
                              aria-pressed="<%= r.asistio === 0 ? 'true' : 'false' %>">No vino</button>
                    </form>
                  <% } %>
                </div>

                <%/* El chevron es la única pista visible de que la ficha se
                     abre; el clic funciona en toda la tarjeta, pero eso solo se
                     descubre después. También es lo que la abre con teclado. */%>
                <button type="button" class="reg-abrir" aria-expanded="false"
                        aria-controls="mas<%= r.id %>" aria-label="Nota y más opciones">▾</button>
              </div>

              <% if (r.nota) { %>
                <div class="reg-nota-vista">✎ <%= r.nota %></div>
              <% } %>

              <div class="reg-mas" id="mas<%= r.id %>">
                <div class="datos reg-datos">
                  <div class="dato">
                    <div class="k">Documento</div>
                    <div class="v"><%= r.tipo_id %> <%= r.num_id %></div>
                  </div>
                  <div class="dato">
                    <div class="k">Teléfono</div>
                    <div class="v"><a href="tel:<%= r.telefono.replace(/\s/g, '') %>"><%= r.telefono %></a></div>
                  </div>
                  <div class="dato">
                    <div class="k">Correo</div>
                    <div class="v"><%= r.email %></div>
                  </div>
                </div>

                <%/* La nota a lo ancho de la ficha: es texto libre y en una
                     columna estrecha no se lee lo que uno mismo escribió. Los
                     botones van abajo, en su propio renglón, para que ninguno
                     quede a un pixel de la casilla de pago. */%>
                <form method="POST" action="/salidas/panel/registros/<%= r.id %>/nota" id="nota<%= r.id %>">
                  <div class="campo">
                    <label for="ntxt<%= r.id %>">Nota (solo la ves tú)</label>
                    <input type="text" name="nota" id="ntxt<%= r.id %>" maxlength="300"
                           value="<%= r.nota || '' %>" placeholder="Paga el viernes, alérgico al maní…" />
                  </div>
                </form>

                <div class="reg-acciones">
                  <button type="submit" form="nota<%= r.id %>" class="btn ghost">Guardar la nota</button>

                  <% if (r.confirmado) { %>
                    <form method="POST" action="/salidas/panel/registros/<%= r.id %>/reenviar">
                      <button type="submit" class="btn ghost" <%= correoActivo ? "" : "disabled" %>>
                        Reenviar confirmación
                      </button>
                    </form>
                    <span class="chip <%= r.avisado_at ? 'ok' : 'alerta' %>">
                      <%= r.avisado_at ? "Avisado" : "Sin avisar" %>
                    </span>
                  <% } else { %>
                    <form method="POST" action="/salidas/panel/registros/<%= r.id %>/borrar"
                          onsubmit="return confirm('¿Sacar a <%= r.nombre %> de la lista? Su cupo vuelve al bus.')">
                      <button type="submit" class="btn peligro">Sacar de la lista</button>
                    </form>
                  <% } %>
                </div>
              </div>
            </article>
          <% }); %>
        </div>
      <% } %>
    </section>
  <% }); %>
</main>

<%/* Abrir la ficha con un clic en cualquier parte de ella. Lo único que hay
     que respetar es que dentro de la ficha viven casillas, botones y un campo
     de texto: tocar cualquiera de esos es usarlos, no abrir ni cerrar. Sin
     esto la página sigue funcionando —el chevron es un botón de verdad—, pero
     hay que apuntarle. */%>
<script>
  document.querySelectorAll(".reg").forEach(function (ficha) {
    const chevron = ficha.querySelector(".reg-abrir");

    function alternar() {
      const abierta = ficha.classList.toggle("abierta");
      if (chevron) chevron.setAttribute("aria-expanded", abierta ? "true" : "false");
    }

    ficha.addEventListener("click", function (e) {
      if (e.target.closest(".reg-abrir")) return alternar();
      // Lo desplegado ya está abierto: ahí dentro nadie quiere cerrarlo sin
      // querer mientras escribe una nota.
      if (e.target.closest(".reg-mas")) return;
      if (e.target.closest("a, button, input, select, textarea, label")) return;
      alternar();
    });
  });
</script>

<%- include('../partials/footer') %>
