<%/* ─────────────────────────────────────────────────────────────────
     Cabecera del sitio de salidas.

     El menú es UNO SOLO para las dos pantallas, igual que en el torneo y en
     la jam: los mismos enlaces en el mismo orden. En escritorio se pintan a
     la derecha de la marca y en celular bajan a una barra fija abajo, al
     alcance del pulgar. Lo único que cambia es el CSS, así que no hay dos
     menús que mantener sincronizados.

     Los dos primeros enlaces son de UNA salida, así que dependen de que la
     página esté mirando alguna. En el listado no hay ninguna y el menú se
     queda en dos: la lista y la consulta.
     ───────────────────────────────────────────────────────────────── */%>
<%
  const s = typeof salida !== "undefined" && salida ? salida : null;

  const ICONOS = {
    salida: '<path d="M8 1.2a4.8 4.8 0 0 0-4.8 4.8c0 3.5 4.8 8.8 4.8 8.8s4.8-5.3 4.8-8.8A4.8 4.8 0 0 0 8 1.2zm0 6.6a1.9 1.9 0 1 1 0-3.8 1.9 1.9 0 0 1 0 3.8z"/>',
    registro: '<path d="M3.2 1.4h6.3L12.8 4.6v10H3.2zM5 6.2h6v1.3H5zM5 9h6v1.3H5zM5 11.8h4v1.3H5z"/>',
    estado: '<path d="M6.9 1.8a5.1 5.1 0 1 0 3.1 9.1l3.1 3.1 1.3-1.3-3.1-3.1a5.1 5.1 0 0 0-4.4-7.8zm0 2a3.1 3.1 0 1 1 0 6.2 3.1 3.1 0 0 1 0-6.2z"/>',
  };
  const icono = (k) => `<svg class="ic" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">${ICONOS[k]}</svg>`;
%>

<header class="sal-top">
  <div class="sal-top-in">
    <a href="/salidas" class="sal-marca">Salidas <em>pedagógicas</em></a>

    <nav class="sal-nav tabs" aria-label="Secciones de la salida">
      <a href="<%= s ? `/salidas/${s.id}` : '/salidas' %>"
         class="<%= activa === 'salida' || activa === 'salidas' ? 'on' : '' %>"
         <%- activa === 'salida' || activa === 'salidas' ? 'aria-current="page"' : '' %>>
        <%- icono('salida') %><span><%= s ? "La salida" : "Salidas" %></span>
      </a>

      <% if (s) { %>
        <a href="/salidas/<%= s.id %>/registro" class="<%= activa === 'registro' ? 'on' : '' %>"
           <%- activa === 'registro' ? 'aria-current="page"' : '' %>>
          <%- icono('registro') %><span>Registro</span>
        </a>
      <% } %>

      <a href="/salidas/estado" class="<%= activa === 'estado' ? 'on' : '' %>"
         <%- activa === 'estado' ? 'aria-current="page"' : '' %>>
        <%- icono('estado') %><span>Mi código</span>
      </a>
    </nav>
  </div>
</header>
