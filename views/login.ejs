<%- include('partials/head', { title: 'Acceso docentes — Expo Multimedia', descripcion: null }) %>
  <div class="login-shell">
    <div class="login-card">
      <div class="logo">Expo<em>Eval</em></div>
      <div class="tag">Evaluación en vivo — Expo Multimedia</div>

      <% if (error) { %>
        <div class="alert err"><%= error %></div>
      <% } %>

      <form method="POST" action="/acceso">
        <div class="form-row">
          <label for="email">Correo institucional</label>
          <input type="email" id="email" name="email" required autocomplete="username"
                 placeholder="tucorreo@<%= DOMINIO %>"
                 pattern="<%= PATRON_CORREO %>"
                 title="Usa tu correo @<%= DOMINIO %>"
                 value="<%= email || '' %>" />
        </div>

        <div class="form-row">
          <label for="password">Contraseña</label>
          <input type="password" id="password" name="password" placeholder="••••••••" autocomplete="current-password" required />
        </div>

        <button type="submit" class="btn block">Entrar</button>
      </form>

      <p style="text-align:center; margin: 18px 0 0">
        <a href="/expo" class="back-link" style="margin:0">Volver a la Expo</a>
      </p>
    </div>
  </div>
</body>
</html>
