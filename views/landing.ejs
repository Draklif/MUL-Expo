<%- include('partials/head', { title: evento.name + ' — ' + programa, descripcion: evento.desc }) %>

<% const partes = evento.name.split(" "); %>

<header class="pub-top">
  <a href="<%= base %>" class="pub-brand"><%= partes[0] %> <em><%= partes.slice(1).join(" ") %></em></a>
  <nav class="pub-nav">
    <a href="#recorrido">Recorrido</a>
    <a href="#lugar">El lugar</a>
    <a href="#horarios">Horarios</a>
    <% if (registro && registro.abierto) { %><a href="/registro" class="pub-destacado">Soy expositor</a><% } %>
    <% if (docente) { %><a href="/panel" class="pub-panel">Mi panel</a><% } %>
  </nav>
</header>

<main class="pub">

  <%/* ───── HERO ───── */%>
  <section class="pub-hero">
    <p class="eyebrow"><%= evento.tipo %> · <%= programa %></p>
    <h1><%= partes[0] %> <em><%= partes.slice(1).join(" ") %></em></h1>
    <p class="lead"><%= evento.desc %></p>

    <div class="hero-meta">
      <div><span>Cuándo</span><strong><%= evento.cuando %></strong></div>
      <div><span>Dónde</span><strong><%= evento.sede %></strong></div>
      <div><span>Recorrido</span><strong><%= salas.length %> experiencias</strong></div>
      <% if (jornada) { %>
        <div><span>Jornada</span><strong><%= jornada.apertura %> – <%= jornada.cierre %></strong></div>
      <% } %>
    </div>

    <div class="hero-ctas">
      <a href="#recorrido" class="btn hero-cta">Ver el recorrido</a>
      <% if (jornada && itinerario.length) { %>
        <a href="#horarios" class="btn ghost hero-cta">Horarios</a>
      <% } %>
      <% if (registro && registro.abierto) { %>
        <a href="/registro" class="btn ghost hero-cta">Soy expositor</a>
      <% } %>
    </div>
  </section>

  <%/* ───── EL RECORRIDO ───── */%>
  <section id="recorrido" class="pub-sec">
    <p class="eyebrow">El recorrido</p>
    <h2><%= salas.length %> experiencias temáticas</h2>
    <p class="sec-lead">
      Cada sala agrupa materias afines y tiene su propio montaje. Se recorren en
      cualquier orden: en todas hay algo que ver, tocar o jugar.
    </p>

    <div class="salas">
      <% salas.forEach((s, i) => { %>
        <article class="sala cat-<%= s.accent %>" id="<%= s.id %>">
          <div class="sala-top">
            <span class="sala-num"><%= String(i + 1).padStart(2, '0') %></span>
            <span class="cat-label"><span class="dot"></span><%= (categorias[s.accent] || {}).short || '' %></span>
          </div>

          <h3><%= s.name %></h3>
          <p class="sala-lema"><%= s.lema %></p>
          <p class="sala-desc"><%= s.desc %></p>

          <ul class="montaje">
            <% (s.montaje || []).forEach(m => { %><li><%= m %></li><% }) %>
          </ul>

          <% if (s.horario) { %>
            <p class="sala-horario">
              <strong><%= s.horario.abre %> – <%= s.horario.cierra %></strong>
              <% if (s.horario.extendido) { %>
                <span class="ext">podría seguir hasta <%= s.horario.extendido %></span>
              <% } %>
            </p>
          <% } %>

          <p class="sala-pie">
            <%= s.semestres %> · <%= s.asignaturas.length %> asignatura<%= s.asignaturas.length === 1 ? '' : 's' %>
          </p>

          <details class="sub">
            <summary>Qué se exhibe</summary>
            <ul class="entregas">
              <% s.asignaturas.forEach(a => { %>
                <li>
                  <span class="asig"><%= a.name %> <em><%= a.sem %>.°</em></span>
                  <% if (a.entregas && a.entregas.length) { %>
                    <span class="ent"><%= a.entregas.join(' · ') %></span>
                  <% } %>
                </li>
              <% }) %>
            </ul>
          </details>
        </article>
      <% }) %>
    </div>
  </section>

  <%/* ───── PLANO DEL LUGAR ───── */%>
  <% if (mapa && mapa.espacios && mapa.espacios.length) {
       // Cada espacio resuelve su nombre, color y detalle (los de tipo "sala"
       // los heredan de la experiencia correspondiente).
       const porSala = Object.fromEntries(salas.map(s => [s.id, s]));
       const espacios = mapa.espacios.map(e => {
         const s = e.tipo === 'sala' ? porSala[e.sala] : null;
         return {
           ...e,
           nombre: s ? s.name : (e.name || ''),
           lema: s ? s.lema : '',
           detalle: s ? s.desc : (e.desc || ''),
           accent: s ? s.accent : '',
           montaje: s ? (s.montaje || []) : [],
           horario: s ? s.horario : null,
           ancla: s ? s.id : null,
         };
       });
  %>
    <section id="lugar" class="pub-sec">
      <p class="eyebrow">El lugar</p>
      <h2><%= mapa.titulo || 'Cómo está distribuido' %></h2>
      <p class="sec-lead"><%= mapa.nota %></p>

      <div class="plano-wrap">
        <div class="plano" id="plano"
             style="aspect-ratio: <%= mapa.cols %> / <%= mapa.filas %>; --cols: <%= mapa.cols %>; --filas: <%= mapa.filas %>">
          <% espacios.forEach(e => { %>
            <% const vertical = e.h > e.w * 2; %>
            <button type="button"
                    class="espacio tipo-<%= e.tipo %> <%= e.accent ? 'cat-' + e.accent : '' %> <%= vertical ? 'vert' : '' %>"
                    id="esp-<%= e.id %>"
                    data-detalle="det-<%= e.id %>"
                    aria-pressed="false"
                    aria-controls="det-<%= e.id %>"
                    style="left:calc(<%= (e.x / mapa.cols) * 100 %>% + 3px);
                           top:calc(<%= (e.y / mapa.filas) * 100 %>% + 3px);
                           width:calc(<%= (e.w / mapa.cols) * 100 %>% - 6px);
                           height:calc(<%= (e.h / mapa.filas) * 100 %>% - 6px)">
              <span class="espacio-nombre"><%= e.nombre %></span>
            </button>
          <% }) %>
        </div>

        <div class="plano-lado">
        <div class="plano-detalle" id="plano-detalle">
          <p class="det-vacio" id="det-vacio">
            Toca cualquier espacio del plano para ver qué pasa ahí.
          </p>

          <% espacios.forEach(e => { %>
            <div class="detalle <%= e.accent ? 'cat-' + e.accent : '' %>" id="det-<%= e.id %>" hidden>
              <p class="det-tipo"><%= e.tipo === 'sala' ? 'Sala del recorrido' : (e.tipo === 'acceso' ? 'Acceso' : (e.tipo === 'pasillo' ? 'Circulación' : 'Servicio')) %></p>
              <h3><%= e.nombre %></h3>
              <% if (e.lema) { %><p class="det-lema"><%= e.lema %></p><% } %>
              <% if (e.horario) { %>
                <p class="det-horario">
                  <%= e.horario.abre %> – <%= e.horario.cierra %><% if (e.horario.extendido) { %> · podría seguir hasta <%= e.horario.extendido %><% } %>
                </p>
              <% } %>
              <p class="det-desc"><%= e.detalle %></p>
              <% if (e.montaje.length) { %>
                <ul class="montaje">
                  <% e.montaje.forEach(m => { %><li><%= m %></li><% }) %>
                </ul>
              <% } %>
              <% if (e.ancla) { %>
                <a href="#<%= e.ancla %>" class="det-link">Ver qué se exhibe →</a>
              <% } %>
            </div>
          <% }) %>
        </div>

          <ul class="plano-leyenda">
            <% salas.forEach(s => { %>
              <li class="cat-<%= s.accent %>"><span class="dot"></span><%= s.name %></li>
            <% }) %>
            <li class="leyenda-otros"><span class="dot"></span>Servicios y circulación</li>
          </ul>
        </div>
      </div>
    </section>
  <% } %>

  <%/* ───── ITINERARIO ───── */%>
  <% if (jornada && itinerario.length) {
       const porSalaIt = Object.fromEntries(salas.map(s => [s.id, s]));
       // Se ordena por hora de inicio y se agrupa en franjas, así el JSON se
       // puede escribir en cualquier orden.
       const franjas = [];
       itinerario
         .slice()
         .sort((a, b) => String(a.hora).localeCompare(String(b.hora)))
         .forEach(it => {
           const ultima = franjas[franjas.length - 1];
           if (ultima && ultima.hora === it.hora) ultima.items.push(it);
           else franjas.push({ hora: it.hora, items: [it] });
         });
  %>
    <section id="horarios" class="pub-sec">
      <p class="eyebrow">Horarios</p>
      <h2><%= jornada.titulo %></h2>
      <p class="sec-lead"><%= jornada.nota %></p>

      <div class="jornada">
        <div><span>Apertura</span><strong><%= jornada.apertura %></strong></div>
        <div><span>Jornada base</span><strong>hasta <%= jornada.cierre %></strong></div>
        <% if (jornada.cierre_extendido) { %>
          <div class="por-confirmar">
            <span>Posible extensión</span>
            <strong>hasta <%= jornada.cierre_extendido %></strong>
          </div>
        <% } %>
        <% if (jornada.estado) { %>
          <div><span>Estado</span><strong class="estado-tent"><%= jornada.estado %></strong></div>
        <% } %>
      </div>

      <div class="filtros" id="filtros" role="group" aria-label="Filtrar el itinerario por sala">
        <button type="button" class="filtro activo" data-sala="" aria-pressed="true">Todo</button>
        <% salas.forEach(s => { %>
          <button type="button" class="filtro cat-<%= s.accent %>" data-sala="<%= s.id %>" aria-pressed="false"><%= s.name %></button>
        <% }) %>
      </div>

      <ol class="timeline" id="timeline">
        <% franjas.forEach(f => { %>
          <li class="franja">
            <div class="franja-hora"><%= f.hora %></div>
            <div class="franja-items">
              <% f.items.forEach(it => { const s = it.sala ? porSalaIt[it.sala] : null; %>
                <article class="acto <%= s ? 'cat-' + s.accent : 'general' %>" data-sala="<%= it.sala || '' %>">
                  <p class="acto-meta">
                    <span class="acto-tipo"><%= it.tipo %></span>
                    <span class="acto-lugar"><%= s ? s.name : (it.lugar || '') %></span>
                    <% if (it.fin) { %><span class="acto-rango"><%= it.hora %>–<%= it.fin %></span><% } %>
                  </p>
                  <h3><%= it.titulo %></h3>
                  <p class="acto-desc"><%= it.desc %></p>
                  <% if (it.tentativo && jornada.aviso_tarde) { %>
                    <p class="acto-aviso"><%= jornada.aviso_tarde %></p>
                  <% } %>
                </article>
              <% }) %>
            </div>
          </li>
        <% }) %>
      </ol>
    </section>
  <% } %>

  <%/* ───── REGISTRO DE EXPOSITORES ───── */%>
  <% if (registro) { %>
    <section id="expositores" class="pub-sec">
      <div class="cta-registro">
        <div>
          <p class="eyebrow">Para estudiantes</p>
          <h2><%= registro.titulo || '¿Vas a exponer?' %></h2>
          <p class="sec-lead" style="margin-bottom:0"><%= registro.abierto ? (registro.nota || '') : (registro.aviso_cerrado || '') %></p>
        </div>
        <div class="cta-botones">
          <% if (registro.abierto) { %>
            <a href="/registro" class="btn">Registrar mi proyecto</a>
          <% } %>
          <% if (requisitos) { %>
            <a href="/expositores" class="btn ghost">Requisitos del stand</a>
          <% } %>
          <% if (registro.abierto) { %>
            <a href="/registro/estado" class="link-consulta">Ya me registré, consultar estado</a>
          <% } %>
        </div>
      </div>
    </section>
  <% } %>

  <%/* ───── CÓMO SE EVALÚA ───── */%>
  <section id="evaluacion" class="pub-sec">
    <p class="eyebrow">Durante la muestra</p>
    <h2>Cómo se evalúa</h2>
    <p class="sec-lead">
      Varios docentes recorren las salas y califican desde el celular con la
      misma rúbrica. Cada criterio va de 0 a <%= ESCALA_MAX %>, y la nota final
      del proyecto es el promedio de todos los jurados que lo evaluaron.
    </p>

    <div class="rubrica">
      <div class="rubrica-col">
        <h4>Al proyecto</h4>
        <ul>
          <% CRITERIOS.forEach(c => { %><li><%= c.label %></li><% }) %>
        </ul>
      </div>
      <div class="rubrica-col">
        <h4>A cada integrante</h4>
        <ul>
          <% CRITERIOS_IND.forEach(c => { %><li><%= c.label %></li><% }) %>
        </ul>
      </div>
    </div>
  </section>
</main>

<footer class="pub-foot">
  <div>
    <strong><%= evento.name %></strong>
    <span><%= programa %></span>
    <%- include('partials/otros-eventos') %>
  </div>
  <a href="<%= docente ? '/panel' : '/acceso' %>" class="foot-acceso">
    <%= docente ? 'Ir al panel' : 'Acceso docentes' %>
  </a>
</footer>

<script>
  // Plano interactivo: un espacio a la vez, se puede deseleccionar tocándolo otra vez.
  (function () {
    var plano = document.getElementById("plano");
    if (!plano) return;

    var espacios = Array.prototype.slice.call(plano.querySelectorAll(".espacio"));
    var vacio = document.getElementById("det-vacio");

    function seleccionar(btn) {
      var apagar = btn.getAttribute("aria-pressed") === "true";

      espacios.forEach(function (b) {
        var activo = !apagar && b === btn;
        b.setAttribute("aria-pressed", activo ? "true" : "false");
        b.classList.toggle("sel", activo);
        document.getElementById(b.dataset.detalle).hidden = !activo;
      });

      vacio.hidden = !apagar;
      if (!apagar) {
        document.getElementById(btn.dataset.detalle)
          .scrollIntoView({ behavior: "smooth", block: "nearest" });
      }
    }

    espacios.forEach(function (b) {
      b.addEventListener("click", function () { seleccionar(b); });
    });
  })();

  // Itinerario: filtrar por sala. Los actos generales (apertura, cierre)
  // se quedan siempre visibles porque le dan contexto a la jornada.
  (function () {
    var filtros = document.getElementById("filtros");
    if (!filtros) return;

    var botones = Array.prototype.slice.call(filtros.querySelectorAll(".filtro"));
    var actos = Array.prototype.slice.call(document.querySelectorAll("#timeline .acto"));
    var franjas = Array.prototype.slice.call(document.querySelectorAll("#timeline .franja"));

    function aplicar(sala) {
      actos.forEach(function (a) {
        var propia = a.dataset.sala;
        a.hidden = Boolean(sala) && Boolean(propia) && propia !== sala;
      });

      franjas.forEach(function (f) {
        var visibles = Array.prototype.slice
          .call(f.querySelectorAll(".acto"))
          .some(function (a) { return !a.hidden; });
        f.hidden = !visibles;
      });

      botones.forEach(function (b) {
        var activo = b.dataset.sala === sala;
        b.classList.toggle("activo", activo);
        b.setAttribute("aria-pressed", activo ? "true" : "false");
      });
    }

    botones.forEach(function (b) {
      b.addEventListener("click", function () { aplicar(b.dataset.sala); });
    });
  })();
</script>

<%- include('partials/footer') %>
