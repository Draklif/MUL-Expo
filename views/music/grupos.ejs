<%- include('../partials/head', { title: title, descripcion: 'Inscribe tu grupo musical o de baile en el Multimedia Music Fest.', css: css, themeColor: themeColor }) %>
<%- include('partials/top') %>

<main class="mf angosto">
  <section class="mf-hero">
    <p class="eyebrow"><%= puertas ? puertas.grupo.lema : 'Grupos culturales' %></p>
    <h1 class="fuego" style="font-size:clamp(36px,8vw,72px)">Inscribe tu grupo</h1>
    <p class="lema"><%= puertas ? puertas.grupo.texto : '' %></p>
  </section>

  <% if (!abierta) { %>
    <div class="aviso malo">
      <p style="margin:0">
        Las inscripciones del festival están cerradas. Si tienes un grupo y
        quieres estar en la próxima edición, escríbele a la organización.
      </p>
    </div>
  <% } else if (!hayCupoActos) { %>
    <div class="aviso malo">
      <p style="margin:0">
        El cartel ya está lleno para esta edición: una tarde no da para más
        grupos de los que ya están inscritos.
      </p>
    </div>
  <% } else { %>

    <% if (errores.length) { %>
      <div class="aviso malo">
        <p style="margin:0"><strong>Revisa esto antes de enviar:</strong></p>
        <ul>
          <% errores.forEach(function (e) { %><li><%= e %></li><% }); %>
        </ul>
      </div>
    <% } %>

    <form method="POST" action="/music/grupos">
      <p class="eyebrow" style="margin-top:8px">1 · El grupo</p>

      <div class="campo">
        <label for="nombre">Nombre del grupo</label>
        <input type="text" id="nombre" name="nombre" maxlength="60" required autocomplete="off"
               placeholder="Como quieren aparecer en el cartel"
               value="<%= valores.nombre || '' %>" />
        <p class="ayuda">Así, tal cual, es como va a salir escrito en el afiche.</p>
      </div>

      <div class="fila">
        <div class="campo">
          <label for="tipo">Qué son</label>
          <select id="tipo" name="tipo" required>
            <option value="">— elige —</option>
            <% tipos.forEach(function (t) { %>
              <option value="<%= t %>" <%= valores.tipo === t ? 'selected' : '' %>><%= t %></option>
            <% }); %>
          </select>
        </div>

        <div class="campo">
          <label for="genero">Género <span class="opcional">(opcional)</span></label>
          <input type="text" id="genero" name="genero" maxlength="60" autocomplete="off"
                 placeholder="Rock, salsa, urbano, contemporáneo…"
                 value="<%= valores.genero || '' %>" />
        </div>
      </div>

      <div class="campo">
        <label for="integrantes">Cuántas personas se suben a la tarima</label>
        <input type="number" id="integrantes" name="integrantes" min="1" max="40" required
               value="<%= valores.integrantes || '' %>" />
        <p class="ayuda">Nos sirve para el montaje: no es lo mismo un dúo que una batucada de quince.</p>
      </div>

      <div class="campo">
        <label for="propuesta">Qué van a presentar</label>
        <textarea id="propuesta" name="propuesta" maxlength="500" required
                  placeholder="Repertorio, duración aproximada y qué tienen pensado hacer en tarima."><%= valores.propuesta || '' %></textarea>
      </div>

      <p class="eyebrow" style="margin-top:30px">2 · Qué necesitan</p>

      <div class="campo">
        <label for="necesidades">Necesidades técnicas <span class="opcional">(opcional)</span></label>
        <textarea id="necesidades" name="necesidades" maxlength="500"
                  placeholder="Cuántos micrófonos, si traen instrumentos, si necesitan monitores, entradas de línea, espacio para bailar…"><%= valores.necesidades || '' %></textarea>
        <p class="ayuda">
          Entre más claro esté esto, mejor les va a sonar. El festival pone consola,
          luces, pantalla y backline; los instrumentos los trae cada grupo.
        </p>
      </div>

      <div class="campo">
        <label for="enlace">Un enlace para escucharlos o verlos <span class="opcional">(opcional)</span></label>
        <input type="text" id="enlace" name="enlace" maxlength="200" autocomplete="url"
               placeholder="YouTube, Instagram, Drive…"
               value="<%= valores.enlace || '' %>" />
      </div>

      <p class="eyebrow" style="margin-top:30px">3 · Quién responde</p>

      <div class="campo">
        <label for="contacto_nombre">Nombre de quien contactamos</label>
        <input type="text" id="contacto_nombre" name="contacto_nombre" maxlength="120" required autocomplete="name"
               value="<%= valores.contacto_nombre || '' %>" />
      </div>

      <div class="fila">
        <div class="campo">
          <label for="contacto_email">Correo institucional</label>
          <input type="email" id="contacto_email" name="contacto_email" maxlength="160" required autocomplete="email"
                 placeholder="tunombre@<%= DOMINIO %>"
                 pattern="<%= PATRON_CORREO %>"
                 title="Usa tu correo @<%= DOMINIO %>"
                 value="<%= valores.contacto_email || '' %>" />
        </div>

        <div class="campo">
          <label for="telefono">Teléfono o WhatsApp <span class="opcional">(opcional)</span></label>
          <input type="tel" id="telefono" name="telefono" maxlength="25" autocomplete="tel"
                 placeholder="300 000 0000"
                 value="<%= valores.telefono || '' %>" />
        </div>
      </div>

      <button type="submit" class="btn block" style="margin-top:8px">Inscribir el grupo</button>
      <p class="ayuda" style="text-align:center">
        Te queda un código y te llega por correo. Inscribirse no es quedar en el
        cartel: la organización lo cierra y te avisamos.
      </p>
    </form>
  <% } %>
</main>

<%- include('partials/pie') %>
<%- include('../partials/footer') %>
