<%/* ─────────────────────────────────────────────────────────────────
     BANDA GENÉRICA

     La que le toca a un evento recién agregado a config.EVENTOS que todavía
     no tiene cara propia. Es la misma idea de views/evento-proximo.ejs: un
     evento es visitable —y aquí, contable— desde el minuto uno, y la página
     se le construye encima después.

     Neutra a propósito. Ponerle a un evento sin identidad el degradado del
     festival o el píxel de la jam sería prestarle una cara que no es suya;
     mejor que se note que le falta la propia.
     ───────────────────────────────────────────────────────────────── */%>
<section class="banda b-gen" id="<%= ev.slug %>">
  <div class="banda-in">

    <header class="b-cab">
      <p class="b-tipo"><%= ev.tipo || 'Evento del programa' %></p>
      <h2><%= ev.nombre %></h2>
      <p class="b-lema"><%= ev.lema %></p>
    </header>

    <div class="b-cols">
      <div class="b-texto">
        <% if (ev.desc) { %><p><%= ev.desc %></p><% } %>
      </div>

      <dl class="b-datos">
        <div>
          <dt>Cuándo</dt>
          <dd><%= ev.cuando || 'Por confirmar' %></dd>
        </div>
        <div>
          <dt>Dónde</dt>
          <dd><%= ev.sede || 'Por confirmar' %></dd>
        </div>
        <div>
          <dt>Este semestre</dt>
          <dd><%= ev.vigente ? 'Es el evento del semestre' : 'En preparación' %></dd>
        </div>
      </dl>
    </div>

    <div class="b-pie">
      <% if (ev.url) { %>
        <a class="b-ir" href="<%= ev.url %>">Ver <%= ev.nombre %></a>
      <% } else { %>
        <p class="b-cerrada">Su página abre cuando sea el evento del semestre.</p>
      <% } %>
    </div>

  </div>
</section>
