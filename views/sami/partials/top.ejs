<%/* ─────────────────────────────────────────────────────────────────
     Cabecera del sitio del semillero.

     Un solo menú para las dos pantallas, igual que en salidas: los mismos
     tres enlaces en el mismo orden. En escritorio se pintan a la derecha de
     la marca; en celular bajan a una barra fija abajo, al alcance del pulgar.
     Lo único que cambia es el CSS, así que no hay dos menús que mantener
     sincronizados.

     Siempre los mismos tres y siempre con el mismo rótulo, aunque el registro
     esté cerrado: un menú que cambia de forma bajo el dedo se siente roto
     aunque cada página por separado esté bien. Que el registro no reciba a
     nadie se dice en la página del registro, que es donde importa. */%>
<%
  const ICONOS = {
    semillero: '<path d="M8 1.4c-2 2.3-3.4 4.3-3.4 6.4a3.4 3.4 0 0 0 2.7 3.3v3.5h1.4v-3.5a3.4 3.4 0 0 0 2.7-3.3c0-2.1-1.4-4.1-3.4-6.4zm0 4.3a2 2 0 1 1 0 4.1 2 2 0 0 1 0-4.1z"/>',
    registro: '<path d="M3.2 1.4h6.3L12.8 4.6v10H3.2zM5 6.2h6v1.3H5zM5 9h6v1.3H5zM5 11.8h4v1.3H5z"/>',
    estado: '<path d="M6.9 1.8a5.1 5.1 0 1 0 3.1 9.1l3.1 3.1 1.3-1.3-3.1-3.1a5.1 5.1 0 0 0-4.4-7.8zm0 2a3.1 3.1 0 1 1 0 6.2 3.1 3.1 0 0 1 0-6.2z"/>',
  };
  const icono = (k) => `<svg class="ic" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">${ICONOS[k]}</svg>`;
%>

<header class="sam-top">
  <div class="sam-top-in">
    <a href="/semillero" class="sam-marca">Semillero <em>SAMI</em></a>

    <nav class="sam-nav tabs" aria-label="Secciones del semillero">
      <a href="/semillero" class="<%= activa === 'semillero' ? 'on' : '' %>"
         <%- activa === 'semillero' ? 'aria-current="page"' : '' %>>
        <%- icono('semillero') %><span>El semillero</span>
      </a>

      <a href="/semillero/registro" class="<%= activa === 'registro' ? 'on' : '' %>"
         <%- activa === 'registro' ? 'aria-current="page"' : '' %>>
        <%- icono('registro') %><span>Registro</span>
      </a>

      <a href="/semillero/estado" class="<%= activa === 'estado' ? 'on' : '' %>"
         <%- activa === 'estado' ? 'aria-current="page"' : '' %>>
        <%- icono('estado') %><span>Mi código</span>
      </a>
    </nav>
  </div>
</header>
