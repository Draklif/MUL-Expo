<%/* ─────────────────────────────────────────────────────────────────
     La tarjeta de un proyecto en la portada del panel.

     Es la misma en los dos bloques —los que dirijo y los de los demás— a
     propósito: lo que cambia no es qué se ve del proyecto sino qué se puede
     hacer con él, y eso se dice al entrar, no en la tarjeta.

     Lo único que se acomoda es la tercera cifra: en un proyecto propio el
     director soy yo y decirlo no informa nada, así que ahí va el codirector.

     Locals:
       p       — el proyecto, con .estudiantes y .reuniones.
       mio     — si soy su director.
       estados — sami.ESTADOS, para la escalera. */%>
<a href="/semillero/panel/proyecto/<%= p.id %>" class="tarjeta">
  <div style="display:flex;gap:10px;align-items:flex-start;flex-wrap:wrap">
    <h3 style="margin:0;flex:1 1 200px"><%= p.titulo %></h3>
    <span class="chip <%= p.estado_info.cls %>" style="flex:0 0 auto"><%= p.estado_info.label %></span>
  </div>

  <p class="mini" style="margin:8px 0 12px">
    <%= p.estudiantes.filter(function (e) { return e.activo; }).map(function (e) { return e.nombre; }).join(" · ") || "Sin integrantes" %>
  </p>

  <%- include('escalera', { estados: estados, actual: p.estado_info }) %>

  <div class="datos" style="margin-top:14px">
    <div class="dato">
      <div class="k">Semestre</div>
      <div class="v grande <%= p.excedido ? "alerta" : "" %>"><%= p.semestre || "—" %></div>
    </div>
    <div class="dato">
      <div class="k">Reuniones</div>
      <div class="v grande <%= p.reuniones ? "" : "apagado" %>"><%= p.reuniones %></div>
    </div>
    <div class="dato">
      <div class="k"><%= mio ? "Codirector" : "Director" %></div>
      <div class="v" style="font-size:14px">
        <%= mio ? p.codirector || "—" : p.director || "Sin asignar" %>
      </div>
    </div>
  </div>
</a>
