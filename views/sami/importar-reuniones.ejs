<%/* ─────────────────────────────────────────────────────────────────
     CARGAR UN LOTE DE REUNIONES

     Para recoger lo que ya se llenó en "Seguimiento y Evaluación", que tiene
     una hoja por semana. Se seleccionan las filas allá, se copian y se pegan
     aquí: el portapapeles de Excel trae las celdas separadas por tabuladores.

     Va por proyecto y no en una página global, al revés que el lote de
     proyectos: en la hoja la fila es del ESTUDIANTE y aquí la reunión es del
     PROYECTO, así que hay nombres que resolver. Desde la ficha se resuelven
     contra los dos integrantes de este proyecto y no contra el semillero
     entero, donde dos "Daniel" se confunden solos.

     Dos pasos, como el otro. Primero se ve qué va a entrar —con las semanas ya
     calculadas y los días repetidos marcados— y solo entonces se guarda.
     ───────────────────────────────────────────────────────────────── */%>
<%- include('../partials/head', { title: title, css: css, themeColor: themeColor }) %>
<%- include('partials/panel-top') %>

<main class="sam">
  <section class="sam-sec">
    <div class="sec-top">
      <div>
        <p class="eyebrow">
          <a href="/semillero/panel/proyecto/<%= proyecto.id %>">Volver a la ficha</a> ·
          semestre <%= periodo ? periodo.codigo : "—" %>
        </p>
        <h2>Cargar reuniones</h2>
      </div>
      <span class="chip cod"><%= proyecto.codigo %></span>
    </div>

    <p class="sec-lead">
      De <strong>Seguimiento y Evaluación</strong>, que lleva una hoja por semana. Abre la
      hoja —<code>S1</code>, <code>S2</code>…—, selecciona las filas de este proyecto de la
      <code>B</code> a la <code>H</code> y pégalas aquí. Entran en
      <strong><%= periodo ? periodo.codigo : "el semestre en curso" %></strong>, y la semana
      (S1…S<%= sami.calendario.semanas %>) se calcula sola con la fecha.
    </p>

    <details style="margin-top:16px">
      <summary class="mini" style="cursor:pointer">Las columnas que espera, en orden</summary>
      <%/* Al ancho de su contenido, como la del otro lote: son rótulos largos y
           repartidos en columnas fijas no se leería ninguno. */%>
      <div class="tabla-envoltura" style="margin-top:10px">
        <table class="tabla auto">
          <thead>
            <tr><% columnas.forEach(function (c, i) { %><th><%= String.fromCharCode(66 + i) %></th><% }); %></tr>
          </thead>
          <tbody>
            <tr><% columnas.forEach(function (c) { %><td class="mini"><%= c.rotulo %></td><% }); %></tr>
          </tbody>
        </table>
      </div>
      <p class="mini" style="margin-top:10px">
        Si arrastras también la <code>A</code> —la del título de la semana— se reconoce y se
        descarta sola. La cabecera, igual. Las filas del <strong>mismo día se juntan en una
        sola reunión</strong>, como pasa en la hoja cuando la fecha va combinada para el
        grupo: basta con que la primera del grupo la traiga.
      </p>
      <p class="mini" style="margin-top:8px">
        En <strong>Firma de Asistencia</strong>, lo que sea que esté escrito cuenta como que
        asistió —para eso se firma—. Solo un <code>NO</code> se lee como falta, y la casilla
        vacía queda <em>sin marcar</em>, que no es lo mismo que no haber ido.
      </p>
    </details>

    <div class="aviso" style="margin-top:18px">
      <p style="margin:0">
        Los nombres se buscan entre los integrantes de este proyecto:
        <% integrantes.forEach(function (e, i) { %><%= i ? " · " : "" %><strong><%= e.nombre %></strong><% }); %><%= integrantes.length ? "" : "ninguno activo" %>.
        Da igual cómo estén escritos en la hoja —con tildes o sin ellas, con los dos apellidos
        o con uno—, pero un nombre que no se reconozca se queda fuera y se dice cuál.
      </p>
    </div>
  </section>

  <% if (errores.length) { %>
    <div class="aviso ojo">
      <div class="t">Esto se va a quedar fuera</div>
      <ul style="margin:0;padding-left:20px">
        <% errores.forEach(function (e) { %><li><%= e %></li><% }); %>
      </ul>
    </div>
  <% } %>

  <section class="sam-sec">
    <form method="POST" action="/semillero/panel/proyecto/<%= proyecto.id %>/reuniones/importar">
      <div class="campo">
        <label for="pegado">Pega aquí las filas</label>
        <textarea name="pegado" id="pegado" style="min-height:200px;font-family:var(--mono);font-size:13px;white-space:pre"
                  placeholder="12/08/2026&#9;Daniel Felipe Sainea&#9;Modelado del edificio&#9;Texturizado&#9;X&#9;4,5&#9;Juan Niño"><%= pegado %></textarea>
      </div>
      <button type="submit" class="btn">Ver qué va a entrar</button>
    </form>
  </section>

  <% if (reuniones) { %>
    <%
      const nuevas = reuniones.filter(function (r) { return !r.ya; });
      const repetidas = reuniones.filter(function (r) { return r.ya; });
      const sinSemana = nuevas.filter(function (r) { return r.semana === null; });
      const sinMarcas = nuevas.filter(function (r) { return !r.marcas.length; });
    %>

    <section class="sam-sec">
      <div class="sec-top">
        <div>
          <p class="eyebrow">Vista previa · todavía no se ha guardado nada</p>
          <h2><%= reuniones.length %> reuni<%= reuniones.length === 1 ? "ón" : "ones" %></h2>
        </div>
      </div>

      <% if (!reuniones.length) { %>
        <div class="vacio">
          No se reconoció ninguna reunión. Revisa que la primera columna sea la
          <strong>fecha</strong> y que al menos una fila la traiga.
        </div>
      <% } else { %>

        <% if (repetidas.length) { %>
          <div class="aviso malo">
            <div class="t"><%= repetidas.length %> se van a omitir</div>
            <p style="margin:0">
              Ese día ya tiene una reunión registrada en <%= periodo ? periodo.codigo : "" %>.
              Pasa al volver a pegar una hoja que ya se cargó, y duplicarla dejaría dos
              reuniones del mismo día con las notas repartidas entre las dos. Si lo que
              quieres es corregirla, ábrela en la ficha.
            </p>
          </div>
        <% } %>

        <% if (sinSemana.length) { %>
          <div class="aviso ojo">
            <div class="t"><%= sinSemana.length %> caen fuera del calendario</div>
            <p style="margin:0">
              Su fecha no está entre las <%= sami.calendario.semanas %> semanas de
              <%= periodo ? periodo.codigo : "este semestre" %>. Entran igual, pero se guardan
              sin número de semana. Revisa si te equivocaste de hoja o de semestre.
            </p>
          </div>
        <% } %>

        <% if (sinMarcas.length) { %>
          <div class="aviso ojo">
            <div class="t"><%= sinMarcas.length %> entran sin ningún estudiante marcado</div>
            <p style="margin:0">
              Quedan los adelantos y los compromisos del día, pero sin asistencia ni notas.
              Suele ser que el nombre de la hoja no coincide con el del integrante.
            </p>
          </div>
        <% } %>

        <div class="tabla-envoltura">
          <table class="tabla">
            <thead>
              <tr>
                <th style="width:6rem"></th><th style="width:5rem">Semana</th>
                <th style="width:7rem">Fecha</th><th style="width:22%">Integrantes</th>
                <th>Adelantos</th><th>Se compromete a</th><th style="width:10rem">Docente</th>
              </tr>
            </thead>
            <tbody>
              <% reuniones.forEach(function (r) { %>
                <tr style="<%= r.ya ? "opacity:.5" : "" %>">
                  <td><span class="chip <%= r.ya ? "malo" : "ok" %>"><%= r.ya ? "Se omite" : "Entra" %></span></td>
                  <td class="cod"><%= r.semana ? "S" + r.semana : "—" %></td>
                  <td class="mini"><%= r.cuando ? r.cuando.diaCorto : r.fecha %></td>
                  <td class="mini">
                    <% r.marcas.forEach(function (m) { %>
                      <div title="<%= m.nombre %>">
                        <%= m.nombre %>
                        <% if (m.asistio === 1) { %><span class="chip ok">asistió</span>
                        <% } else if (m.asistio === 0) { %><span class="chip malo">no asistió</span>
                        <% } else { %><span class="chip no">sin marcar</span><% } %>
                        <%= m.calificacion === null ? "" : " · " + m.calificacion %>
                      </div>
                    <% }); %>
                    <%= r.marcas.length ? "" : "—" %>
                  </td>
                  <%/* Los textos largos se cortan con puntos suspensivos y van
                       enteros en el title: la vista previa es para comprobar
                       QUÉ va a entrar, no para leerlo, y un adelanto de cinco
                       renglones deja la fila de al lado flotando. */%>
                  <td class="mini" title="<%= r.adelantos || "" %>"><%= r.adelantos || "—" %></td>
                  <td class="mini" title="<%= r.compromisos || "" %>"><%= r.compromisos || "—" %></td>
                  <td class="mini" title="<%= r.docente || "" %>"><%= r.docente || "—" %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <% if (nuevas.length) { %>
          <form method="POST" action="/semillero/panel/proyecto/<%= proyecto.id %>/reuniones/importar/confirmar"
                style="margin-top:22px"
                onsubmit="return confirm('Se van a registrar <%= nuevas.length %> reuniones en <%= periodo ? periodo.codigo : "" %>. ¿Seguimos?')">
            <input type="hidden" name="pegado" value="<%= pegado %>" />
            <button type="submit" class="btn">
              Registrar <%= nuevas.length %> reuni<%= nuevas.length === 1 ? "ón" : "ones" %>
            </button>
          </form>
        <% } %>
      <% } %>
    </section>
  <% } %>
</main>

<%- include('../partials/footer') %>
