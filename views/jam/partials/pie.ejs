      <strong>Jam de Altura</strong><br />
      <%= programa %> · <%= institucion %>
    </div>
    <div class="der">
      <a href="/jam/inscripcion">Inscribirse</a>
      <a href="/jam/inscripcion/estado">Consultar código</a>
