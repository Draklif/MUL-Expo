<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <%/* La barra del navegador en Android toma este color. Es un local y no un
       fijo porque cada evento puede traer su propio ambiente. */%>
  <meta name="theme-color" content="<%= typeof themeColor !== 'undefined' ? themeColor : '#0c0c0f' %>" />
  <title><%= typeof title !== 'undefined' ? title : 'Expo Multimedia' %></title>
  <% if (typeof descripcion !== 'undefined' && descripcion) { %>
  <meta name="description" content="<%= descripcion %>" />
  <meta property="og:description" content="<%= descripcion %>" />
  <% } %>
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'Expo Multimedia' %>" />
  <meta property="og:type" content="website" />
  <%/* Marca provisional dibujada en el propio href: ni un 404 de favicon en
       cada página ni un archivo de relleno en public/. Cuando llegue el logo
       oficial se deja en public/marca/favicon.svg y esta línea pasa a
       href="/marca/favicon.svg". No hay que tocar nada más. */%>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%230921AD'/%3E%3Cpath d='M9 22V10h3l4 7 4-7h3v12h-3v-6l-4 6-4-6v6z' fill='%23fff'/%3E%3C/svg%3E" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <%/* Una display por evento: Fraunces para la Expo, Archivo condensada para
       Virtual Champions, Press Start 2P —la de las consolas de 8 bits— para la
       Jam de Altura, que además usa Space Mono de cuerpo de texto, y Anton
       para el Music Fest, que es la de los carteles de festival: una sola
       grosura, condensada y siempre en mayúsculas. Van todas en el mismo link
       porque son una sola petición y el navegador solo descarga la que la hoja
       de estilos de esa página termine usando. */%>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Archivo:wdth,wght@75,600;75,700;100,500;100,600;100,700&family=Anton&family=Press+Start+2P&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <%/* Una sola hoja por página, no dos. Si un evento quiere identidad propia,
       pasa su 'css' y reemplaza a styles.css entera: apilar las dos obligaría a
       deshacer a mano cada regla de la que está debajo (styles.css es oscura
       desde body, a, h1…). Quien no pase 'css' sigue con la de siempre. */%>
  <link rel="stylesheet" href="<%= typeof css !== 'undefined' ? css : '/styles.css' %>" />
</head>
<body>
