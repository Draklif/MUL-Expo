<%/* Los demás eventos del programa, al pie. Es el único hilo que los une: no
     hay portada que los liste, así que quien llegue a uno pueda saltar a otro.
     La lista y las direcciones salen de config.EVENTOS (res.locals.EVENTOS). */%>
<%/* Se filtra por slug y no por url: la página vigente se ve tanto en "/" como
     en su propia dirección, y por url se enlazaría a sí misma en la segunda. */%>
<% const otros = EVENTOS.filter(e => e.slug !== slug); %>
<% if (otros.length) { %>
  <p class="foot-eventos">
    <span>También en Multimedia:</span>
    <% otros.forEach(e => { %><a href="<%= e.url %>"><%= e.nombre %></a><% }) %>
  </p>
<% } %>
