<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#0f0e0c" />
  <title><%= typeof title !== 'undefined' ? title : 'Expo Eval' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <% if (docente) { %>
  <header class="topbar">
    <div class="brand">Expo<em>Eval</em></div>
    <div class="user">
      <strong><%= docente.name %></strong>
      <form method="POST" action="/logout" style="display:inline">
        <button type="submit" class="logout-btn">Salir</button>
      </form>
    </div>
  </header>
  <nav class="nav-pills">
    <a href="/" class="<%= typeof active !== 'undefined' && active === 'home' ? 'active' : '' %>">Materias</a>
    <a href="/tablero" class="<%= typeof active !== 'undefined' && active === 'tablero' ? 'active' : '' %>">Tablero en vivo</a>
  </nav>
  <% } %>
